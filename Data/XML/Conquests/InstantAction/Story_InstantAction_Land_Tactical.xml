<?xml version="1.0" ?>

<Story>
	<Event Name="Trigger_Setup_Start">
		<Event_Type>STORY_ELAPSED</Event_Type>
		<Event_Param1>0</Event_Param1>
	</Event>

	<Event Name="Instructions">
		<Event_Type>STORY_ELAPSED</Event_Type>
		<Event_Param1>0</Event_Param1>
		<Reward_Type>SCREEN_TEXT</Reward_Type>
		<Reward_Param1>TEXT_INSTANT_ACTION_BEGIN</Reward_Param1>
		<Reward_Param7>Task</Reward_Param7><!-- TASK color coding - Blue -->
	</Event>
	
	<Event Name="IA_Screentext_1">
		<Event_Type>STORY_AI_NOTIFICATION</Event_Type>
		<Event_Param2>AI_NOTIF_IA_TECH_1</Event_Param2>
		<Reward_Type>SCREEN_TEXT</Reward_Type>
		<Reward_Param1>Tech 1</Reward_Param1>
		<Reward_Param2>5</Reward_Param2>
		<Perpetual>true</Perpetual>
	</Event>
	
	<Event Name="IA_Screentext_2">
		<Event_Type>STORY_AI_NOTIFICATION</Event_Type>
		<Event_Param2>AI_NOTIF_IA_TECH_2</Event_Param2>
		<Reward_Type>SCREEN_TEXT</Reward_Type>
		<Reward_Param1>Tech 2</Reward_Param1>
		<Reward_Param2>5</Reward_Param2>
		<Perpetual>true</Perpetual>
	</Event>
	
	<Event Name="IA_Screentext_3">
		<Event_Type>STORY_AI_NOTIFICATION</Event_Type>
		<Event_Param2>AI_NOTIF_IA_TECH_3</Event_Param2>
		<Reward_Type>SCREEN_TEXT</Reward_Type>
		<Reward_Param1>Tech 3</Reward_Param1>
		<Reward_Param2>5</Reward_Param2>
		<Perpetual>true</Perpetual>
	</Event>
	
	<Event Name="IA_Screentext_4">
		<Event_Type>STORY_AI_NOTIFICATION</Event_Type>
		<Event_Param2>AI_NOTIF_IA_TECH_4</Event_Param2>
		<Reward_Type>SCREEN_TEXT</Reward_Type>
		<Reward_Param1>Tech 4</Reward_Param1>
		<Reward_Param2>5</Reward_Param2>
		<Perpetual>true</Perpetual>
	</Event>
	
	<Event Name="IA_Screentext_5">
		<Event_Type>STORY_AI_NOTIFICATION</Event_Type>
		<Event_Param2>AI_NOTIF_IA_TECH_5</Event_Param2>
		<Reward_Type>SCREEN_TEXT</Reward_Type>
		<Reward_Param1>Tech 5</Reward_Param1>
		<Reward_Param2>5</Reward_Param2>
		<Perpetual>true</Perpetual>
	</Event>

	<Event Name="Flash_Movie_Button">
		<Event_Type>STORY_ELAPSED</Event_Type>
		<Reward_Type>FLASH_GUI</Reward_Type>
		<Reward_Param1>b_camera_t</Reward_Param1>
		<Prereq>Instructions</Prereq>
	</Event>

	<Event Name="Instructions_2">
		<Event_Type>STORY_CLICK_GUI</Event_Type>
		<Event_Param1>b_camera_t</Event_Param1>
		<Reward_Type>SCREEN_TEXT</Reward_Type>
		<Reward_Param1>TEXT_INSTANT_ACTION_BATTLE</Reward_Param1>
		<Reward_Param7>Task</Reward_Param7><!-- TASK color coding - Blue -->
	</Event>

	<Event Name="Remove_Flash_Movie_Button">
		<Event_Type>STORY_ELAPSED</Event_Type>
		<Event_Param1>0</Event_Param1>
		<Reward_Type>HIDE_TUTORIAL_CURSOR</Reward_Type>
		<Prereq>Instructions_2</Prereq>
	</Event>

	<Event Name="Trigger_Battle_Start">
		<Event_Type>STORY_CLICK_GUI</Event_Type>
		<Event_Param1>b_camera_t</Event_Param1>
	</Event>

	<Event Name="Remove_FoW">
		<Event_Type>STORY_TRIGGER</Event_Type>
		<Reward_Type>ENABLE_FOW</Reward_Type>
		<Reward_Param1>0</Reward_Param1>
		<Prereq>Trigger_Battle_Start</Prereq>
	</Event>

	<Event Name="Disable_Retreat">
		<Event_Type>STORY_ELAPSED</Event_Type>
		<Event_Param1>0</Event_Param1>
		<Reward_Type>DISABLE_RETREAT</Reward_Type>
		<Reward_Param1>Rebel</Reward_Param1>
		<Reward_Param2>1</Reward_Param2>
	</Event>

	<Event Name="Disable_Retreat_Player">
		<Event_Type>STORY_ELAPSED</Event_Type>
		<Event_Param1>0</Event_Param1>
		<Reward_Type>DISABLE_RETREAT</Reward_Type>
		<Reward_Param1>Empire</Reward_Param1>
		<Reward_Param2>1</Reward_Param2>
	</Event>

	<Event Name="Disable_Reinforcements">
		<Event_Type>STORY_AI_NOTIFICATION</Event_Type>
		<Event_Param2>NO_REINFORCEMENTS</Event_Param2>
		<Reward_Type>DISABLE_REINFORCEMENTS</Reward_Type>
		<Reward_Param1>1</Reward_Param1>
		<Perpetual>true</Perpetual>
	</Event>

	<Event Name="Close_Reinforcement_Window">
		<Event_Type>STORY_TRIGGER</Event_Type>
		<Reward_Type>FORCE_CLICK_GUI</Reward_Type>
		<Reward_Param1>r_close</Reward_Param1>
		<Prereq>Disable_Reinforcements</Prereq>
		<Perpetual>true</Perpetual>
	</Event>

	<Event Name="Enable_Reinforcements">
		<Event_Type>STORY_AI_NOTIFICATION</Event_Type>
		<Event_Param2>ENABLE_REINFORCEMENTS</Event_Param2>
		<Reward_Type>DISABLE_REINFORCEMENTS</Reward_Type>
		<Reward_Param1>0</Reward_Param1>
		<Perpetual>true</Perpetual>
	</Event>

	<Event Name="Disable_Victory">
		<Event_Type>STORY_TRIGGER</Event_Type>
		<Reward_Type>ENABLE_VICTORY</Reward_Type>
		<Reward_Param1>0</Reward_Param1>
		<Prereq>Trigger_Battle_Start</Prereq>
	</Event>

	<Event Name="Re_Enable_Victory">
		<Event_Type>STORY_AI_NOTIFICATION</Event_Type>
		<Event_Param2>IA_RESTART_MODE</Event_Param2>
		<Reward_Type>ENABLE_VICTORY</Reward_Type>
		<Reward_Param1>1</Reward_Param1>
	</Event>

	<Event Name="End_Battle">
		<Event_Type>STORY_TRIGGER</Event_Type>
		<Reward_Type>VICTORY</Reward_Type>
		<Reward_Param1></Reward_Param1> <!-- Set by State_Setup_Start in Script_InstantAction_Tactical -->
		<Reward_Param2>0</Reward_Param2>
		<Prereq>Re_Enable_Victory</Prereq>
	</Event>
</Story>
